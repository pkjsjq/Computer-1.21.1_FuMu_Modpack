{
  "enableHud": true,
  "enableTaskBook": true,
  "enableSoundEffects": true,
  "maxTasksPerPlayer": 100,
  "autoSave": true,
  "autoSaveIntervalMinutes": 5,
  "defaultPriority": "MEDIUM",
  "enableTaskRewards": false,
  "defaultPersonalProjectInitialized": true,
  // commandAccessMode 说明：
  // OP_ONLY：仅 OP 可用所有命令
  // VIEW_ONLY：普通玩家仅可使用查看类命令，编辑类仍需 OP
  // FULL：普通玩家可使用查看/编辑类命令（不建议公共服务器）
  "commandAccessMode": "OP_ONLY",
  // storageBackend 说明：
  // nbt：已废弃的旧版文件存储，配置将被忽略并强制使用 h2
  // h2：H2 数据库存储（强制使用，唯一支持的存储模式）
  "storageBackend": "h2",
  // h2BackupOnStart 说明：
  // false：启动时不创建 H2 备份
  // true：启动初始化 H2 后自动创建一次备份（仅在 storageBackend 为 h2 时生效）
  "h2BackupOnStart": false,
